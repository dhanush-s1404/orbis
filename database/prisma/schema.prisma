generator client {
  provider = "prisma-client"
  output   = "../../backend/src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  DEVELOPER
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum ProjectStatus {
  SUBMITTED
  REVIEWING
  REQUIREMENTS_CONFIRMED
  PROPOSAL
  DEVELOPMENT
  TESTING
  CUSTOMER_REVIEW
  REVISIONS
  DEPLOYMENT
  COMPLETED
  ARCHIVED
}

enum ProjectRequirementType {
  WEBSITE_TYPE
  INDUSTRY
  BUSINESS_DESCRIPTION
  TARGET_AUDIENCE
  REQUIRED_PAGES
  REQUIRED_FEATURES
  DESIGN_PREFERENCES
  REFERENCE_WEBSITES
  EXISTING_WEBSITE
  DOMAIN
  HOSTING
  AUTHENTICATION
  USER_ACCOUNTS
  ECOMMERCE
  SHOPPING_CART
  PAYMENTS
  BOOKING
  CMS
  BLOG
  SEARCH
  NOTIFICATIONS
  EMAIL
  FILE_UPLOADS
  ANALYTICS
  SEO
  MULTI_LANGUAGE
  API_INTEGRATIONS
  SOCIAL_MEDIA
  DATABASE
  CUSTOM_FUNCTIONALITY
  BUDGET
  TIMELINE
  ADDITIONAL_INFO
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  status        Status    @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordResetToken    String?
  passwordResetExpires  DateTime?
  emailVerificationToken String?
  emailVerificationSent DateTime?

  orders          Order[]
  projects        Project[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortDescription String?
  fullDescription  String?
  price            Decimal
  discountPrice    Decimal?
  categoryId       String?
  demoUrl          String?
  status           Status   @default(ACTIVE)
  featured         Boolean  @default(false)
  license          String   @default("standard")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category     Category?           @relation(fields: [categoryId], references: [id])
  features     ProductFeature[]
  technologies ProductTechnology[]
  images       ProductImage[]

  orderItems OrderItem[]
}

model ProductFeature {
  id        String @id @default(uuid())
  productId String
  name      String

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, name])
}

model ProductTechnology {
  id        String @id @default(uuid())
  productId String
  name      String

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, name])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  total         Decimal       @default(0)
  currency      String        @default("INR")
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING)
  paymentId     String?
  sessionId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  price     Decimal @default(0)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Project {
  id                String        @id @default(uuid())
  projectId         String        @unique
  userId            String
  name              String
  description       String?
  budget            Decimal?
  timeline          String
  status            ProjectStatus @default(SUBMITTED)
  progress          Int           @default(0) // 0-100
  assignedDeveloper String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  requirements ProjectRequirement[]
  messages     ProjectMessage[]
  files        ProjectFile[]
  aiUsage      AIUsage?

  builderState      String?       // JSON: templateId, pages, sections, content, styles
  templateId        String?       // references a template in the template library

  // Publishing fields
  publishStatus     String?       // DRAFT, PUBLISHED, PUBLISH_FAILED
  publishedAt       DateTime?     // when project was published
  publishedSlug     String?       // unique public slug
  publishedCount    Int           @default(0) // how many times published
}

model ProjectRequirement {
  id        String                 @id @default(uuid())
  projectId String
  type      ProjectRequirementType
  value     String
  createdAt DateTime               @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, type])
}

model ProjectMessage {
  id        String   @id @default(uuid())
  projectId String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  uploadedBy String
  fileName   String
  fileType   String
  fileUrl    String
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  userId     String?
  details    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Template {
  id          String    @id @default(uuid())
  name        String
  description String?
  previewUrl  String
  category    String
  pages       String    // JSON: structured page layout definition
  sections    String    // JSON: available sections and their configuration
  defaultContent String   // JSON: default content placeholders
  defaultStyles String  // JSON: default styling configuration
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AIUsage {
  id        String    @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  businessName String
  industry   String
  targetAudience String
  goal       String
  tone       String
  services   String[]
  location   String?
  stylePreference String?
  generationCount Int @default(0)
  createdAt DateTime @default(now())
}